APP_NAME=Bac Exercise Generator API
DEBUG=false

# CORS
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bac_generator

# LLM
LLM_PROVIDER=ollama
LLM_MAX_ATTEMPTS=6

# Ollama - local development
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Gemini / Vertex AI - production
GEMINI_PROJECT=
GEMINI_LOCATION=europe-west1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=8192

# Retrieval-augmented generation
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
PINECONE_API_KEY=
PINECONE_INDEX_NAME=bac-exercises-rag
PINECONE_NAMESPACE=bac-exercises
RAG_ENABLED=true
RAG_FAIL_OPEN=true
RERANKER_ENABLED=false
RERANKER_MODEL=semantic-ranker-default@latest
RERANKER_TOP_N=5

# Firebase Authentication
FIREBASE_PROJECT_ID=

# Code execution
CODE_RUNNER_PROVIDER=local

# Rate limiting
RATE_LIMITER_PROVIDER=memory
REDIS_HOST=
REDIS_PORT=6379
