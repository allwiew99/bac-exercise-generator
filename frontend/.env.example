# Backend API. The only source of truth for the FastAPI base URL — never
# hardcode it in source. Example: https://bac-generator-xxxxx.a.run.app
NEXT_PUBLIC_API_BASE_URL=

# Firebase Web SDK config (browser-safe by design, not secrets).
# Get these from Firebase Console > Project Settings > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Development-only mock mode. Serves in-memory fixtures instead of calling
# the backend. Ignored automatically outside NODE_ENV=development, so it
# can never activate in a production build even if left "true" by mistake.
NEXT_PUBLIC_USE_MOCK_API=false
